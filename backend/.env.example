# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND NESTJS - THCS ĐÔNG QUANG
# ==============================================================================

NODE_ENV=production
PORT=3001

# Chuỗi kết nối PostgreSQL (Prisma ORM)
# Chạy cục bộ: postgresql://postgres:postgres@localhost:5432/thcs_dong_quang?schema=public
# Docker Compose: postgresql://postgres:your_password@postgres:5432/thcs_dong_quang?schema=public
DATABASE_URL="postgresql://postgres:password_placeholder@postgres:5432/thcs_dong_quang?schema=public"

# URL của Frontend Client (phục vụ CORS và xác thực Cookie)
# Có thể truyền nhiều URL ngăn cách bằng dấu phẩy: http://150.136.x.x,https://dongquang.edu.vn
FRONTEND_URL="http://your_oracle_vm_public_ip_placeholder"

# Cookie Secure (false cho HTTP Public IP, true cho HTTPS)
COOKIE_SECURE=false

# Bí mật mã hóa JWT Access Token (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET="your_production_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="15m"

# Bí mật mã hóa JWT Refresh Token (Khác với JWT_SECRET)
JWT_REFRESH_SECRET="your_production_jwt_refresh_secret_key_minimum_32_characters"
JWT_REFRESH_EXPIRES_IN="7d"

# Thông tin tài khoản Quản trị tối cao (Super Admin)
QUAN_TRI_EMAIL="thangbe6868@gmail.com"
QUAN_TRI_USERNAME="admin"
QUAN_TRI_MAT_KHAU="your_strong_admin_password_here"
