# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU - CỔNG THÔNG TIN TRƯỜNG THCS ĐÔNG QUANG
# ==============================================================================
# Hướng dẫn trên Oracle Cloud VM:
# 1. Sao chép file này thành file .env: cp .env.example .env
# 2. Điền các giá trị bí mật (secret) thực tế của bạn vào file .env
# 3. TUYỆT ĐỐI KHÔNG commit file .env chứa mật khẩu thật lên GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL (Chạy nội bộ trong Docker, không mở ra Internet)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_placeholder
POSTGRES_DB=thcs_dong_quang

# Chuỗi kết nối Database cho Prisma (khi chạy trong Docker Network)
DATABASE_URL="postgresql://postgres:your_strong_postgres_password_placeholder@postgres:5432/thcs_dong_quang?schema=public"

# ------------------------------------------------------------------------------
# 2. XÁC THỰC BẢO MẬT & JWT TOKENS
# ------------------------------------------------------------------------------
# Tạo chuỗi ngẫu nhiên 32 ký tự bằng lệnh: openssl rand -base64 32
JWT_SECRET=your_production_jwt_secret_minimum_32_characters_placeholder
JWT_EXPIRES_IN=15m

# Khóa JWT Refresh riêng biệt (phải khác với JWT_SECRET)
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_minimum_32_characters_placeholder
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. ĐỊA CHỈ & MIỀN TRUY CẬP HỆ THỐNG
# ------------------------------------------------------------------------------
# Giai đoạn 1 (Chưa có Domain): Điền Public IP của Oracle VM, ví dụ: http://150.136.x.x
# Giai đoạn 2 (Đã có Domain): Đổi thành domain trường, ví dụ: https://dongquang.edu.vn
# Có thể điền nhiều URL ngăn cách bằng dấu phẩy: http://150.136.x.x,https://dongquang.edu.vn
FRONTEND_URL=http://your_oracle_vm_public_ip_placeholder

# Cookie Secure:
# - Điền false khi đang dùng HTTP trực tiếp qua Public IP
# - Điền true khi đã kích hoạt Cloudflare / HTTPS
COOKIE_SECURE=false

# NEXT_PUBLIC_API_URL cho Frontend Next.js:
# - Để trống ("") để trình duyệt tự động gọi Same-Origin qua Nginx (/api/v1) trên bất kỳ Public IP hay Domain nào
NEXT_PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# 4. TÀI KHOẢN QUẢN TRỊ VIÊN HỆ THỐNG BAN ĐẦU (SUPER ADMIN)
# ------------------------------------------------------------------------------
QUAN_TRI_EMAIL=thangbe6868@gmail.com
QUAN_TRI_USERNAME=admin
QUAN_TRI_MAT_KHAU=your_initial_admin_password_placeholder
